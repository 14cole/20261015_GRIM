{
  "slug": "wedge_conic",
  "title": "Wedge Conic",
  "description": "Exact waterline relabel plus independent tilted Jones-matrix rotation.",
  "settings": "Waterline: 0/90/180/270 degrees; tilted: 30-degree azimuth steps and tilts -30/-15/0/15/30 degrees; VV HH VH.",
  "scope": "Waterline mapping, a constant reciprocal Jones control, and unsupported side directions. Does not qualify interpolation of arbitrary sparse wedge measurements.",
  "category": "BETA dataset operation",
  "atol": 1e-10,
  "rtol": 1e-09,
  "inputs": [
    {
      "id": "water_p0",
      "label": "Waterline input 0 deg power",
      "value": 3.0,
      "unit": "m2"
    },
    {
      "id": "water_a0",
      "label": "Waterline input 0 deg angle",
      "value": 0,
      "unit": "deg"
    },
    {
      "id": "water_p1",
      "label": "Waterline input 90 deg power",
      "value": 9.0,
      "unit": "m2"
    },
    {
      "id": "water_a1",
      "label": "Waterline input 90 deg angle",
      "value": 90,
      "unit": "deg"
    },
    {
      "id": "water_p2",
      "label": "Waterline input 180 deg power",
      "value": 18.0,
      "unit": "m2"
    },
    {
      "id": "water_a2",
      "label": "Waterline input 180 deg angle",
      "value": 180,
      "unit": "deg"
    },
    {
      "id": "water_p3",
      "label": "Waterline input 270 deg power",
      "value": "missing",
      "unit": "m2"
    },
    {
      "id": "water_a3",
      "label": "Waterline input 270 deg angle",
      "value": 270,
      "unit": "deg"
    },
    {
      "id": "vvi",
      "label": "Constant wedge vvi",
      "value": 2.0,
      "unit": "sqrt(m2)"
    },
    {
      "id": "vvq",
      "label": "Constant wedge vvq",
      "value": 0.4,
      "unit": "sqrt(m2)"
    },
    {
      "id": "hhi",
      "label": "Constant wedge hhi",
      "value": 0.8,
      "unit": "sqrt(m2)"
    },
    {
      "id": "hhq",
      "label": "Constant wedge hhq",
      "value": 0.1,
      "unit": "sqrt(m2)"
    },
    {
      "id": "vhi",
      "label": "Constant wedge vhi",
      "value": 0.35,
      "unit": "sqrt(m2)"
    },
    {
      "id": "vhq",
      "label": "Constant wedge vhq",
      "value": -0.2,
      "unit": "sqrt(m2)"
    },
    {
      "id": "t0_lon",
      "label": "Control 1 conic azimuth",
      "value": 30.0,
      "unit": "deg"
    },
    {
      "id": "t0_lat",
      "label": "Control 1 conic elevation",
      "value": 15.0,
      "unit": "deg"
    },
    {
      "id": "t1_lon",
      "label": "Control 2 conic azimuth",
      "value": -30.0,
      "unit": "deg"
    },
    {
      "id": "t1_lat",
      "label": "Control 2 conic elevation",
      "value": -15.0,
      "unit": "deg"
    }
  ],
  "calculations": [
    {
      "id": "t0_x",
      "label": "Control 1 direction x",
      "formula": "=COS(RADIANS(@t0_lat))*COS(RADIANS(@t0_lon))",
      "unit": ""
    },
    {
      "id": "t0_y",
      "label": "Control 1 direction y",
      "formula": "=COS(RADIANS(@t0_lat))*SIN(RADIANS(@t0_lon))",
      "unit": ""
    },
    {
      "id": "t0_z",
      "label": "Control 1 direction z",
      "formula": "=SIN(RADIANS(@t0_lat))",
      "unit": ""
    },
    {
      "id": "t0_sp",
      "label": "Control 1 sin mechanical angle",
      "formula": "=-@t0_y",
      "unit": ""
    },
    {
      "id": "t0_cp",
      "label": "Control 1 cos mechanical angle",
      "formula": "=SQRT(1-@t0_sp^2)",
      "unit": ""
    },
    {
      "id": "t0_st",
      "label": "Control 1 sin tilt",
      "formula": "=@t0_z/@t0_cp",
      "unit": ""
    },
    {
      "id": "t0_ct",
      "label": "Control 1 cos tilt",
      "formula": "=@t0_x/@t0_cp",
      "unit": ""
    },
    {
      "id": "t0_a",
      "label": "Control 1 wedge V dot conic V",
      "formula": "=@t0_st*SIN(RADIANS(@t0_lat))*COS(RADIANS(@t0_lon))+@t0_ct*COS(RADIANS(@t0_lat))",
      "unit": ""
    },
    {
      "id": "t0_b",
      "label": "Control 1 wedge V dot conic H",
      "formula": "=@t0_st*SIN(RADIANS(@t0_lon))",
      "unit": ""
    },
    {
      "id": "t0_c",
      "label": "Control 1 wedge H dot conic V",
      "formula": "=-@t0_sp*@t0_ct*SIN(RADIANS(@t0_lat))*COS(RADIANS(@t0_lon))-@t0_cp*SIN(RADIANS(@t0_lat))*SIN(RADIANS(@t0_lon))+@t0_sp*@t0_st*COS(RADIANS(@t0_lat))",
      "unit": ""
    },
    {
      "id": "t0_d",
      "label": "Control 1 wedge H dot conic H",
      "formula": "=-@t0_sp*@t0_ct*SIN(RADIANS(@t0_lon))+@t0_cp*COS(RADIANS(@t0_lon))",
      "unit": ""
    },
    {
      "id": "t1_x",
      "label": "Control 2 direction x",
      "formula": "=COS(RADIANS(@t1_lat))*COS(RADIANS(@t1_lon))",
      "unit": ""
    },
    {
      "id": "t1_y",
      "label": "Control 2 direction y",
      "formula": "=COS(RADIANS(@t1_lat))*SIN(RADIANS(@t1_lon))",
      "unit": ""
    },
    {
      "id": "t1_z",
      "label": "Control 2 direction z",
      "formula": "=SIN(RADIANS(@t1_lat))",
      "unit": ""
    },
    {
      "id": "t1_sp",
      "label": "Control 2 sin mechanical angle",
      "formula": "=-@t1_y",
      "unit": ""
    },
    {
      "id": "t1_cp",
      "label": "Control 2 cos mechanical angle",
      "formula": "=SQRT(1-@t1_sp^2)",
      "unit": ""
    },
    {
      "id": "t1_st",
      "label": "Control 2 sin tilt",
      "formula": "=@t1_z/@t1_cp",
      "unit": ""
    },
    {
      "id": "t1_ct",
      "label": "Control 2 cos tilt",
      "formula": "=@t1_x/@t1_cp",
      "unit": ""
    },
    {
      "id": "t1_a",
      "label": "Control 2 wedge V dot conic V",
      "formula": "=@t1_st*SIN(RADIANS(@t1_lat))*COS(RADIANS(@t1_lon))+@t1_ct*COS(RADIANS(@t1_lat))",
      "unit": ""
    },
    {
      "id": "t1_b",
      "label": "Control 2 wedge V dot conic H",
      "formula": "=@t1_st*SIN(RADIANS(@t1_lon))",
      "unit": ""
    },
    {
      "id": "t1_c",
      "label": "Control 2 wedge H dot conic V",
      "formula": "=-@t1_sp*@t1_ct*SIN(RADIANS(@t1_lat))*COS(RADIANS(@t1_lon))-@t1_cp*SIN(RADIANS(@t1_lat))*SIN(RADIANS(@t1_lon))+@t1_sp*@t1_st*COS(RADIANS(@t1_lat))",
      "unit": ""
    },
    {
      "id": "t1_d",
      "label": "Control 2 wedge H dot conic H",
      "formula": "=-@t1_sp*@t1_ct*SIN(RADIANS(@t1_lon))+@t1_cp*COS(RADIANS(@t1_lon))",
      "unit": ""
    }
  ],
