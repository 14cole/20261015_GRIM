  "calculations": [
    {
      "id": "di0",
      "label": "Coherent bin 1 mean I",
      "formula": "=(SQRT(@input_coherent_0_p)*COS(RADIANS(@input_coherent_0_ph))+SQRT(@input_coherent_1_p)*COS(RADIANS(@input_coherent_1_ph)))/2",
      "unit": ""
    },
    {
      "id": "dq0",
      "label": "Coherent bin 1 mean Q",
      "formula": "=(SQRT(@input_coherent_0_p)*SIN(RADIANS(@input_coherent_0_ph))+SQRT(@input_coherent_1_p)*SIN(RADIANS(@input_coherent_1_ph)))/2",
      "unit": ""
    },
    {
      "id": "di1",
      "label": "Coherent bin 2 mean I",
      "formula": "=(SQRT(@input_coherent_2_p)*COS(RADIANS(@input_coherent_2_ph))+SQRT(@input_coherent_3_p)*COS(RADIANS(@input_coherent_3_ph)))/2",
      "unit": ""
    },
    {
      "id": "dq1",
      "label": "Coherent bin 2 mean Q",
      "formula": "=(SQRT(@input_coherent_2_p)*SIN(RADIANS(@input_coherent_2_ph))+SQRT(@input_coherent_3_p)*SIN(RADIANS(@input_coherent_3_ph)))/2",
      "unit": ""
    },
    {
      "id": "di2",
      "label": "Coherent bin 3 mean I",
      "formula": "=(SQRT(@input_coherent_4_p)*COS(RADIANS(@input_coherent_4_ph)))/1",
      "unit": ""
    },
    {
      "id": "dq2",
      "label": "Coherent bin 3 mean Q",
      "formula": "=(SQRT(@input_coherent_4_p)*SIN(RADIANS(@input_coherent_4_ph)))/1",
      "unit": ""
    }
