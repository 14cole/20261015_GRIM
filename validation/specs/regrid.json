{
  "slug": "regrid",
  "title": "Regrid",
  "description": "Linear interpolation of I and Q, including exact source nodes.",
  "settings": "Azimuth target [0,5,10,15,20] deg; no extrapolation.",
  "scope": "Checks linear interpolation arithmetic and missing support, not adequacy of source angular sampling.",
  "category": "Dataset operation",
  "atol": 1e-10,
  "rtol": 1e-09,
