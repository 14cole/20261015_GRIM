  "calculations": [
    {
      "id": "w0",
      "label": "Fraction between source samples 1 and 2",
      "formula": "=(@target_0-@input_0_az)/(@input_1_az-@input_0_az)",
      "unit": ""
    },
    {
      "id": "re0",
      "label": "Interpolated I at 0 deg",
      "formula": "=(1-@w0)*SQRT(@input_0_p)*COS(RADIANS(@input_0_ph))+@w0*SQRT(@input_1_p)*COS(RADIANS(@input_1_ph))",
      "unit": ""
    },
    {
      "id": "im0",
      "label": "Interpolated Q at 0 deg",
      "formula": "=(1-@w0)*SQRT(@input_0_p)*SIN(RADIANS(@input_0_ph))+@w0*SQRT(@input_1_p)*SIN(RADIANS(@input_1_ph))",
      "unit": ""
    },
    {
      "id": "w1",
      "label": "Fraction between source samples 1 and 2",
      "formula": "=(@target_1-@input_0_az)/(@input_1_az-@input_0_az)",
      "unit": ""
    },
    {
      "id": "re1",
      "label": "Interpolated I at 5 deg",
      "formula": "=(1-@w1)*SQRT(@input_0_p)*COS(RADIANS(@input_0_ph))+@w1*SQRT(@input_1_p)*COS(RADIANS(@input_1_ph))",
      "unit": ""
    },
    {
      "id": "im1",
      "label": "Interpolated Q at 5 deg",
      "formula": "=(1-@w1)*SQRT(@input_0_p)*SIN(RADIANS(@input_0_ph))+@w1*SQRT(@input_1_p)*SIN(RADIANS(@input_1_ph))",
      "unit": ""
    },
    {
      "id": "w2",
      "label": "Fraction between source samples 2 and 3",
      "formula": "=(@target_2-@input_1_az)/(@input_2_az-@input_1_az)",
      "unit": ""
    },
    {
      "id": "re2",
      "label": "Interpolated I at 10 deg",
      "formula": "=(1-@w2)*SQRT(@input_1_p)*COS(RADIANS(@input_1_ph))+@w2*SQRT(@input_2_p)*COS(RADIANS(@input_2_ph))",
      "unit": ""
    },
    {
      "id": "im2",
      "label": "Interpolated Q at 10 deg",
      "formula": "=(1-@w2)*SQRT(@input_1_p)*SIN(RADIANS(@input_1_ph))+@w2*SQRT(@input_2_p)*SIN(RADIANS(@input_2_ph))",
      "unit": ""
    },
    {
      "id": "w3",
      "label": "Fraction between source samples 2 and 3",
      "formula": "=(@target_3-@input_1_az)/(@input_2_az-@input_1_az)",
      "unit": ""
    },
    {
      "id": "re3",
      "label": "Interpolated I at 15 deg",
      "formula": "=(1-@w3)*SQRT(@input_1_p)*COS(RADIANS(@input_1_ph))+@w3*SQRT(@input_2_p)*COS(RADIANS(@input_2_ph))",
      "unit": ""
    },
    {
      "id": "im3",
      "label": "Interpolated Q at 15 deg",
      "formula": "=(1-@w3)*SQRT(@input_1_p)*SIN(RADIANS(@input_1_ph))+@w3*SQRT(@input_2_p)*SIN(RADIANS(@input_2_ph))",
      "unit": ""
    },
    {
      "id": "w4",
      "label": "Fraction between source samples 2 and 3",
      "formula": "=(@target_4-@input_1_az)/(@input_2_az-@input_1_az)",
      "unit": ""
    },
    {
      "id": "re4",
      "label": "Interpolated I at 20 deg",
      "formula": "=(1-@w4)*SQRT(@input_1_p)*COS(RADIANS(@input_1_ph))+@w4*SQRT(@input_2_p)*COS(RADIANS(@input_2_ph))",
      "unit": ""
    },
    {
      "id": "im4",
      "label": "Interpolated Q at 20 deg",
      "formula": "=(1-@w4)*SQRT(@input_1_p)*SIN(RADIANS(@input_1_ph))+@w4*SQRT(@input_2_p)*SIN(RADIANS(@input_2_ph))",
      "unit": ""
    }
  ],
  "checks": [
    {
      "case": "Sample 1",
      "metric": "Azimuth",
      "formula": "=@target_0",
      "actual": 0.0,
      "unit": "deg",
      "source": "result.csv row 2: azimuth",
      "tolerance": null
    },
    {
      "case": "Sample 1",
      "metric": "Power",
      "formula": "=@re0^2+@im0^2",
      "actual": 1.0,
      "unit": "linear power",
      "source": "result.csv row 2: magnitude_power_linear",
      "tolerance": null
    },
    {
      "case": "Sample 1",
