    {
      "case": "Gapped center 90 deg",
      "metric": "Median power",
      "formula": "=IF(COUNT(@g2,@g3)=0,\"missing\",MEDIAN(@g2,@g3))",
      "actual": 12.5,
      "unit": "m2",
      "source": "result_gapped.csv row 6: magnitude_power_linear",
      "tolerance": null
    },
    {
      "case": "Gapped center 90 deg",
      "metric": "Center",
      "formula": "=10+4*20",
      "actual": 90.0,
      "unit": "deg",
      "source": "result_gapped.csv row 6: azimuth",
      "tolerance": null
    },
    {
      "case": "Nonpositive window",
      "metric": "Invalid input handling",
      "formula": "=\"REJECTED\"",
      "actual": "REJECTED",
      "unit": "",
      "source": "Recorded GRIM operation response",
      "tolerance": null
    }
  ],
  "files": [
