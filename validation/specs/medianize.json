{
  "slug": "medianize",
  "title": "Medianize",
  "description": "Sliding medians of linear power, with periodic seam handling and empty-window preservation.",
  "settings": "Periodic: window 200 deg, slide 90 deg. Open/gapped: window 20 deg, slide 20 deg, nonperiodic.",
  "scope": "Numerical behavior for the supplied fixtures; not all possible inputs.",
  "category": "Dataset operation",
  "atol": 1e-10,
  "rtol": 1e-09,
  "inputs": [
    {
      "id": "p0",
      "label": "Periodic source at 0.0 deg",
      "value": 1.0,
      "unit": "m2"
    },
    {
      "id": "p1",
      "label": "Periodic source at 90.0 deg",
      "value": 4.0,
      "unit": "m2"
    },
    {
      "id": "p2",
      "label": "Periodic source at 180.0 deg",
      "value": 9.0,
      "unit": "m2"
    },
    {
      "id": "p3",
      "label": "Periodic source at 270.0 deg",
      "value": 16.0,
      "unit": "m2"
    },
    {
      "id": "p4",
      "label": "Periodic source at 360.0 deg",
      "value": 1.0,
      "unit": "m2"
    },
    {
      "id": "g0",
      "label": "Gapped source at 0.0 deg",
      "value": 1.0,
      "unit": "m2"
    },
    {
      "id": "g1",
      "label": "Gapped source at 20.0 deg",
      "value": "missing",
      "unit": "m2"
    },
    {
      "id": "g2",
      "label": "Gapped source at 80.0 deg",
      "value": 9.0,
      "unit": "m2"
    },
    {
      "id": "g3",
      "label": "Gapped source at 100.0 deg",
      "value": 16.0,
      "unit": "m2"
    }
  ],
  "calculations": [],
  "checks": [
    {
      "case": "Periodic center 0 deg",
      "metric": "Median power",
      "formula": "=MEDIAN(@p3,@p0,@p1)",
      "actual": 4.0,
      "unit": "m2",
      "source": "result_periodic.csv row 2: magnitude_power_linear",
      "tolerance": null
    },
    {
      "case": "Periodic center 0 deg",
      "metric": "Center",
      "formula": "=0*90",
      "actual": 0.0,
      "unit": "deg",
      "source": "result_periodic.csv row 2: azimuth",
      "tolerance": null
    },
    {
      "case": "Periodic center 90 deg",
      "metric": "Median power",
      "formula": "=MEDIAN(@p0,@p1,@p2)",
      "actual": 4.0,
      "unit": "m2",
      "source": "result_periodic.csv row 3: magnitude_power_linear",
      "tolerance": null
    },
    {
      "case": "Periodic center 90 deg",
      "metric": "Center",
      "formula": "=1*90",
      "actual": 90.0,
      "unit": "deg",
      "source": "result_periodic.csv row 3: azimuth",
      "tolerance": null
    },
    {
      "case": "Periodic center 180 deg",
      "metric": "Median power",
      "formula": "=MEDIAN(@p1,@p2,@p3)",
      "actual": 9.0,
      "unit": "m2",
      "source": "result_periodic.csv row 4: magnitude_power_linear",
      "tolerance": null
    },
    {
      "case": "Periodic center 180 deg",
      "metric": "Center",
      "formula": "=2*90",
      "actual": 180.0,
      "unit": "deg",
      "source": "result_periodic.csv row 4: azimuth",
      "tolerance": null
    },
    {
      "case": "Periodic center 270 deg",
      "metric": "Median power",
      "formula": "=MEDIAN(@p2,@p3,@p0)",
      "actual": 9.0,
      "unit": "m2",
      "source": "result_periodic.csv row 5: magnitude_power_linear",
      "tolerance": null
    },
    {
      "case": "Periodic center 270 deg",
      "metric": "Center",
      "formula": "=3*90",
      "actual": 270.0,
      "unit": "deg",
      "source": "result_periodic.csv row 5: azimuth",
      "tolerance": null
    },
    {
      "case": "Gapped center 10 deg",
      "metric": "Median power",
      "formula": "=IF(COUNT(@g0,@g1)=0,\"missing\",MEDIAN(@g0,@g1))",
      "actual": 1.0,
      "unit": "m2",
      "source": "result_gapped.csv row 2: magnitude_power_linear",
      "tolerance": null
    },
    {
      "case": "Gapped center 10 deg",
      "metric": "Center",
      "formula": "=10+0*20",
      "actual": 10.0,
      "unit": "deg",
      "source": "result_gapped.csv row 2: azimuth",
      "tolerance": null
    },
    {
      "case": "Gapped center 30 deg",
      "metric": "Median power",
      "formula": "=IF(COUNT(@g1)=0,\"missing\",MEDIAN(@g1))",
      "actual": "missing",
      "unit": "m2",
      "source": "result_gapped.csv row 3: magnitude_power_linear",
      "tolerance": null
    },
    {
      "case": "Gapped center 30 deg",
      "metric": "Center",
      "formula": "=10+1*20",
      "actual": 30.0,
      "unit": "deg",
      "source": "result_gapped.csv row 3: azimuth",
      "tolerance": null
    },
    {
      "case": "Gapped center 50 deg",
      "metric": "Median power",
      "formula": "=\"missing\"",
      "actual": "missing",
      "unit": "m2",
      "source": "result_gapped.csv row 4: magnitude_power_linear",
      "tolerance": null
    },
    {
      "case": "Gapped center 50 deg",
      "metric": "Center",
      "formula": "=10+2*20",
      "actual": 50.0,
      "unit": "deg",
      "source": "result_gapped.csv row 4: azimuth",
      "tolerance": null
    },
    {
      "case": "Gapped center 70 deg",
      "metric": "Median power",
      "formula": "=IF(COUNT(@g2)=0,\"missing\",MEDIAN(@g2))",
      "actual": 9.0,
      "unit": "m2",
      "source": "result_gapped.csv row 5: magnitude_power_linear",
      "tolerance": null
    },
    {
      "case": "Gapped center 70 deg",
      "metric": "Center",
      "formula": "=10+3*20",
      "actual": 70.0,
      "unit": "deg",
      "source": "result_gapped.csv row 5: azimuth",
      "tolerance": null
