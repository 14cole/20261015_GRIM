  "calculations": [
    {
      "id": "merge_i",
      "label": "Overlap mean I",
      "formula": "=(SQRT(@input_a_1_p)*COS(RADIANS(@input_a_1_ph))+SQRT(@input_b_0_p)*COS(RADIANS(@input_b_0_ph)))/2",
      "unit": ""
    },
    {
      "id": "merge_q",
      "label": "Overlap mean Q",
      "formula": "=(SQRT(@input_a_1_p)*SIN(RADIANS(@input_a_1_ph))+SQRT(@input_b_0_p)*SIN(RADIANS(@input_b_0_ph)))/2",
      "unit": ""
    }
  ],
