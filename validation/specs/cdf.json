{
  "slug": "cdf",
  "title": "CDF",
  "description": "Inclusive empirical probabilities preserve zeros and exclude missing samples.",
  "settings": "Sample weighting; one run; linear power; CDF and exceedance.",
  "scope": "Sample-weighted population including ties. Coordinate-weighted quadrature is not exercised.",
  "category": "Plot",
  "atol": 1e-10,
  "rtol": 1e-09,
  "inputs": [
    {
      "id": "p0",
      "label": "Input power, sample 1",
      "value": 0.0,
      "unit": "m^2"
    },
    {
      "id": "p1",
      "label": "Input power, sample 2",
      "value": 1.0,
      "unit": "m^2"
    },
    {
      "id": "p2",
      "label": "Input power, sample 3",
      "value": 1.0,
      "unit": "m^2"
    },
    {
      "id": "p3",
      "label": "Input power, sample 4",
      "value": 4.0,
      "unit": "m^2"
    },
    {
      "id": "p4",
      "label": "Input power, sample 5",
      "value": 9.0,
      "unit": "m^2"
    },
    {
      "id": "p5",
      "label": "Input power, sample 6",
      "value": "missing",
      "unit": "m^2"
    }
  ],
  "calculations": [],
  "checks": [
    {
      "case": "Complete distribution",
      "metric": "Distinct level count",
      "formula": "=4",
      "actual": 4,
      "unit": "count",
      "source": "probabilities.csv data-row count",
      "tolerance": 0
    },
    {
      "case": "Level 1",
      "metric": "Support coordinate",
      "formula": "=@p0",
      "actual": 0.0,
      "unit": "m^2",
      "source": "probabilities.csv row 2: level",
      "tolerance": null
    },
    {
      "case": "Threshold 0.0",
      "metric": "cdf",
      "formula": "=100*COUNTIFS(@p0:@p5,\"<=\"&@p0,@p0:@p5,\">=0\")/COUNT(@p0:@p5)",
      "actual": 20.0,
      "unit": "%",
      "source": "probabilities.csv row 2: cdf",
      "tolerance": null
    },
    {
      "case": "Threshold 0.0",
      "metric": "exceedance",
      "formula": "=100*COUNTIFS(@p0:@p5,\">=\"&@p0,@p0:@p5,\">=0\")/COUNT(@p0:@p5)",
      "actual": 100.0,
      "unit": "%",
      "source": "probabilities.csv row 2: exceedance",
      "tolerance": null
    },
    {
