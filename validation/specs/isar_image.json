    {
      "id": "umax",
      "label": "Inscribed Cartesian maximum U frequency",
      "formula": "= @f0*SIN(RADIANS((@az1-@az0)/2))",
      "unit": "Hz"
    },
    {
      "id": "vmax",
      "label": "Inscribed Cartesian maximum V frequency",
      "formula": "=SQRT(@f1^2-@umax^2)",
      "unit": "Hz"
    },
    {
