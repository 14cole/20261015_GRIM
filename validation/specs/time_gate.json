  "calculations": [
    {
      "id": "edge",
      "label": "Raised cosine edge width",
      "formula": "=@taper*(@stop-@start)/2",
      "unit": "m"
    },
    {
      "id": "r0",
      "label": "Range cell 0",
      "formula": "=0*@c/(2*@df*@size)",
      "unit": "m"
    },
    {
      "id": "m0",
      "label": "Range cell 0 gate",
      "formula": "=IF(AND(@r0>=@start,@r0<=@stop),IF(@r0<@start+@edge,0.5-0.5*COS(PI()*(@r0-@start)/@edge),IF(@r0>@stop-@edge,0.5-0.5*COS(PI()*(@stop-@r0)/@edge),1)),0)",
      "unit": ""
    },
    {
      "id": "ri0",
      "label": "Gated range cell 0 I",
      "formula": "=((@i0*COS(2*PI()*0*0/@size)-@q0*SIN(2*PI()*0*0/@size))+(@i1*COS(2*PI()*0*1/@size)-@q1*SIN(2*PI()*0*1/@size))+(@i2*COS(2*PI()*0*2/@size)-@q2*SIN(2*PI()*0*2/@size))+(@i3*COS(2*PI()*0*3/@size)-@q3*SIN(2*PI()*0*3/@size)))/@size*@m0",
      "unit": ""
    },
    {
