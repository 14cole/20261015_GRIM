      "formula": "=((@i0*COS(2*PI()*1*0/@size)-@q0*SIN(2*PI()*1*0/@size))+(@i1*COS(2*PI()*1*1/@size)-@q1*SIN(2*PI()*1*1/@size))+(@i2*COS(2*PI()*1*2/@size)-@q2*SIN(2*PI()*1*2/@size))+(@i3*COS(2*PI()*1*3/@size)-@q3*SIN(2*PI()*1*3/@size)))/@size*@m1",
