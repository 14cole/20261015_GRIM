{
  "slug": "time_gate",
  "title": "Time Gate",
  "description": "Explicit inverse and forward DFT sums independently reproduce the gated field.",
  "settings": "4 frequencies from 1 to 4 GHz; 16-point padding; gate -0.03 to 0.04 m; taper 0.4; compensation off except center-point control.",
  "scope": "Checks direct DFT, taper, keep/remove/full gates, time sign and center-point compensation. Does not prove scatterer separation in arbitrary measured data.",
  "category": "BETA dataset operation",
  "atol": 1e-10,
  "rtol": 1e-09,
  "inputs": [
    {
      "id": "c",
      "label": "c",
      "value": 299792458.0,
      "unit": "m/s"
    },
    {
      "id": "df",
      "label": "df",
      "value": 1000000000.0,
      "unit": "Hz"
    },
    {
      "id": "n",
      "label": "n",
      "value": 4,
      "unit": ""
    },
    {
      "id": "size",
      "label": "size",
      "value": 16,
      "unit": ""
    },
    {
      "id": "start",
      "label": "start",
      "value": -0.03,
      "unit": "m"
    },
    {
      "id": "stop",
      "label": "stop",
      "value": 0.04,
      "unit": "m"
    },
    {
      "id": "taper",
      "label": "taper",
      "value": 0.4,
      "unit": ""
    },
    {
      "id": "i0",
      "label": "Frequency 1 input I",
      "value": 1.0,
      "unit": "sqrt(m2)"
    },
    {
      "id": "q0",
      "label": "Frequency 1 input Q",
      "value": 2.0,
      "unit": "sqrt(m2)"
    },
    {
      "id": "i1",
      "label": "Frequency 2 input I",
      "value": 2.0,
      "unit": "sqrt(m2)"
    },
    {
      "id": "q1",
      "label": "Frequency 2 input Q",
      "value": -0.5,
      "unit": "sqrt(m2)"
    },
    {
      "id": "i2",
      "label": "Frequency 3 input I",
      "value": -0.5,
      "unit": "sqrt(m2)"
    },
    {
      "id": "q2",
      "label": "Frequency 3 input Q",
      "value": 0.25,
      "unit": "sqrt(m2)"
    },
    {
      "id": "i3",
      "label": "Frequency 4 input I",
      "value": 3.0,
      "unit": "sqrt(m2)"
    },
    {
      "id": "q3",
