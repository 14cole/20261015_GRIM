      "formula": "=((@i0*SIN(2*PI()*0*0/@size)+@q0*COS(2*PI()*0*0/@size))+(@i1*SIN(2*PI()*0*1/@size)+@q1*COS(2*PI()*0*1/@size))+(@i2*SIN(2*PI()*0*2/@size)+@q2*COS(2*PI()*0*2/@size))+(@i3*SIN(2*PI()*0*3/@size)+@q3*COS(2*PI()*0*3/@size)))/@size*@m0",
      "unit": ""
    },
    {
      "id": "r1",
      "label": "Range cell 1",
      "formula": "=1*@c/(2*@df*@size)",
      "unit": "m"
    },
    {
      "id": "m1",
      "label": "Range cell 1 gate",
      "formula": "=IF(AND(@r1>=@start,@r1<=@stop),IF(@r1<@start+@edge,0.5-0.5*COS(PI()*(@r1-@start)/@edge),IF(@r1>@stop-@edge,0.5-0.5*COS(PI()*(@stop-@r1)/@edge),1)),0)",
      "unit": ""
